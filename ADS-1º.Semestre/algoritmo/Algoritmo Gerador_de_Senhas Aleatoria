Algoritmo "Gerador_de_Senhas_Categorizadas"

Var
    // Vetor para armazenar as 10 senhas
    vetorSenhas : vetor [1..10] de caractere
    
    // Cadeia com os caracteres permitidos (39 caracteres no total)
    caracteresPermitidos : caractere
    
    categoria, senhaAtual : caractere
    i, j, indiceAleatorio : inteiro

Inicio
    // Inicialização dos caracteres permitidos conforme a regra
    caracteresPermitidos <- "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@!#"
    
    // Loop principal para gerar as 10 senhas
    Para i de 1 ate 10 faca
        
        // Loop de validação da categoria
        Repita
            Escreva("Digite a categoria do usuário ", i, " (P - Professor, A - Aluno, F - Funcionário): ")
            Leia(categoria)
            
            // Converte para maiúsculo para evitar problemas com letras minúsculas
            categoria <- Maiusc(categoria)
            
            Se (categoria <> "P") e (categoria <> "A") e (categoria <> "F") Entao
                Escreval("Categoria inválida! Por favor, digite apenas P, A ou F.")
            FimSe
            
        Ate (categoria = "P") ou (categoria = "A") ou (categoria = "F")
        
        // O primeiro caractere da senha é a própria categoria
        senhaAtual <- categoria
        
        // Loop para gerar os 7 caracteres aleatórios restantes (totalizando 8)
        Para j de 1 ate 7 faca
            // Sorteia um índice entre 1 e 39 (quantidade de caracteres permitidos)
            indiceAleatorio <- Aleatorio(1, 39) 
            
            // Concatena o caractere sorteado à senha atual
            senhaAtual <- senhaAtual + Copia(caracteresPermitidos, indiceAleatorio, 1)
        FimPara
        
        // Armazena a senha gerada no vetor
        vetorSenhas[i] <- senhaAtual
        
        // Exibe a senha gerada imediatamente ao usuário
        Escreval("Senha ", i, " gerada com sucesso: ", senhaAtual)
        Escreval("--------------------------------------------------")
        
    FimPara
    
    // Bloco final: Exibição de todas as senhas armazenadas no vetor
    Escreval("")
    Escreval("=== LISTA DAS 10 SENHAS GERADAS ===")
    Para i de 1 ate 10 faca
        Escreval("Posição ", i, ": ", vetorSenhas[i])
    FimPara

FimAlgoritmo
