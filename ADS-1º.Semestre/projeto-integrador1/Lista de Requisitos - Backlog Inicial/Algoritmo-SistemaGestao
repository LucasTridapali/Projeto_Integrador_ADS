algoritmo "Sistema_Gestao_Pesquisas"
// Disciplina : Projeto Integrador I
// Descrição  : Fluxo de Casos de Uso (Administração e Respondente)
// Autor(a)   : Equipe de Projeto
// Data       : 10/06/2026

tipo
   // Estrutura para simular uma pesquisa no sistema
   Pesquisa = registro
      titulo: caractere
      vigente: logico
      categoria: caractere
      totalSenhasGeradas: inteiro
   fimregistro

var
   // Variáveis Globais de Controle
   pesquisaAtual: Pesquisa
   senhaValida, loginSucesso: logico
   opcaoMenu: inteiro
   senhaDigitada: caractere
   respostaFormulario: caractere

// ==========================================
// MÓDULOS ADMINISTRATIVOS
// ==========================================

procedimento EfetuarLoginAdministrativo()
var
   usuario, senha: caractere
inicio
   escreval("=== UC01: AUTENTICAÇÃO ADMINISTRATIVA ===")
   escreva("Digite o usuário: ")
   leia(usuario)
   escreva("Digite a senha: ")
   leia(senha)
   
   se (usuario = "admin") e (senha = "fatec123") entao
      loginSucesso <- verdadeiro
      escreval("Login efetuado com sucesso!")
   senao
      loginSucesso <- falso
      escreval("Erro: Usuário ou senha inválidos.")
   fimse
fimprocedimento

procedimento CadastrarPesquisaECategorias()
inicio
   escreval("=== UC02 e UC03: CADASTRO DE PESQUISA E CATEGORIAS ===")
   escreva("Digite o título da nova pesquisa: ")
   leia(pesquisaAtual.titulo)
   
   // Simulação da inclusão obrigatória de categorias (UC03)
   escreval("Selecione a categoria alvo para esta pesquisa:")
   escreval("1 - Alunos (Discentes)")
   escreval("2 - Professores (Docentes)")
   escreval("3 - Colaboradores Administrativos")
   escreva("Opção: ")
   leia(opcaoMenu)
   
   escolha opcaoMenu
      caso 1
         pesquisaAtual.categoria <- "Alunos"
      caso 2
         pesquisaAtual.categoria <- "Professores"
      caso 3
         pesquisaAtual.categoria <- "Administrativo"
      outrocaso
         pesquisaAtual.categoria <- "Geral"
   fimescolha
   
   pesquisaAtual.vigente <- verdadeiro
   escreval("Pesquisa '", pesquisaAtual.titulo, "' cadastrada com sucesso para: ", pesquisaAtual.categoria)
fimprocedimento

procedimento GerarLoteSenhas()
inicio
   escreval("=== UC05: GERAR LOTE DE SENHAS ANÔNIMAS ===")
   se pesquisaAtual.titulo = "" entao
      escreval("Erro: É necessário cadastrar uma pesquisa primeiro.")
   senao
      escreva("Quantas senhas deseja gerar para esta pesquisa? ")
      leia(pesquisaAtual.totalSenhasGeradas)
      escreval(pesquisaAtual.totalSenhasGeradas, " senhas geradas aleatoriamente no banco de dados.")
      escreval("[UC06 Extensão]: Senhas prontas para exportação em PDF/CSV.")
   fimse
fimprocedimento

// ==========================================
// MÓDULOS DO RESPONDENTE
// ==========================================

funcao ValidarSenhaAcesso(token: caractere) : logico
inicio
   escreval("=== UC07: VALIDAR SENHA DE ACESSO ===")
   // Simulação simplificada de validação de token válido
   se (token = "FATEC2026") ou (token = "ANONIMO123") entao
      retorne verdadeiro
   senao
      retorne falso
   fimse
fimfuncao

procedimento ResponderQuestionario()
inicio
   escreval("=== UC08: RESPONDER QUESTIONÁRIO (INCLUSÃO DE UC07) ===")
   escreva("Insira sua senha anônima de acesso: ")
   leia(senhaDigitada)
   
   senhaValida <- ValidarSenhaAcesso(senhaDigitada)
   
   se (senhaValida) e (pesquisaAtual.vigente) entao
      escreval("Acesso concedido à pesquisa: ", pesquisaAtual.titulo)
      escreval("Categoria detectada: ", pesquisaAtual.categoria)
      escreval("--------------------------------------------------")
      escreva("Pergunta 1: Como avalia a infraestrutura técnica? (Ótimo/Bom/Regular/Ruim): ")
      leia(respostaFormulario)
      
      // O sistema consome a senha para que nunca mais possa ser usada
      escreval("Obrigado! Sua resposta foi registrada com 100% de anonimato.")
      escreval("A senha utilizada foi invalidada pelo sistema.")
   senao
      escreval("Erro: Senha inválida ou período de vigência da pesquisa expirou [UC11].")
   fimse
fimprocedimento

// ==========================================
// FLUXO PRINCIPAL DO SISTEMA
// ==========================================
inicio
   loginSucesso <- falso
   pesquisaAtual.titulo <- ""
   pesquisaAtual.vigente <- falso
   
   repita
      escreval("")
      escreval("=============================================")
      escreval("      SISTEMA DE GESTÃO DE PESQUISAS         ")
      escreval("=============================================")
      escreval("1 - Acessar Painel Administrativo (ADM)")
      escreval("2 - Responder Questionário (Respondente)")
      escreval("3 - Simular Bloqueio Automático por Tempo [CRON - UC11]")
      escreval("0 - Sair do Sistema")
      escreva("Escolha uma opção: ")
      leia(opcaoMenu)
      
      escolha opcaoMenu
         caso 1
            EfetuarLoginAdministrativo()
            se loginSucesso entao
               repita
                  escreval("")
                  escreval("--- PAINEL ADM ---")
                  escreval("1.1 - Cadastrar Nova Pesquisa")
                  escreval("1.2 - Gerar Lote de Senhas")
                  escreval("1.3 - Visualizar Dashboard [UC09]")
                  escreval("1.4 - Logoff")
                  escreva("Opção ADM: ")
                  leia(opcaoMenu)
                  
                  escolha opcaoMenu
                     caso 1.1
                        CadastrarPesquisaECategorias()
                     caso 1.2
                        GerarLoteSenhas()
                     caso 1.3
                        escreval("=== UC09: Dashboard ===")
                        escreval("Pesquisa: ", pesquisaAtual.titulo)
                        escreval("Total de senhas vinculadas: ", pesquisaAtual.totalSenhasGeradas)
                        escreval("Status da pesquisa: ", pesquisaAtual.vigente)
                  fimescolha
               ate opcaoMenu = 1.4
               loginSucesso <- falso // Reseta login ao sair
            fimse
            
         caso 2
            se pesquisaAtual.titulo = "" entao
               escreval("Nenhuma pesquisa ativa no momento. Aguarde o ADM.")
            senao
               ResponderQuestionario()
            fimse
            
         caso 3
            escreval("=== UC11: MONITORAMENTO DE TEMPO (CRON) ===")
            pesquisaAtual.vigente <- falso
            escreval("O tempo de vigência expirou. A pesquisa '", pesquisaAtual.titulo, "' foi bloqueada automaticamente.")
            
         caso 0
            escreval("Encerrando o sistema...")
      fimescolha
   ate opcaoMenu = 0
fimalgoritmo
