programa
{

    funcao inicio()
    {
        // Declaração de Variáveis
        cadeia senhas[10] // Vetor de 10 posições para armazenar as senhas
        cadeia categoria
        cadeia caracteres_permitidos = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@!#"
        cadeia senha_gerada
        inteiro i, j, indice_aleatorio, total_caracteres
        
        // Obtém o tamanho total da string de caracteres permitidos
        total_caracteres = txt.numero_caracteres(caracteres_permitidos) 

        escreva("=== GERADOR DE SENHAS SEGUIDAS ===\n\n")

        // Laço principal para gerar as 10 senhas
        para (i = 0; i < 10; i++)
        {
            escreva("\n--- Gerando a ", i + 1, "ª senha ---\n")
            
            // Validação da categoria do usuário
            faca 
            {
                escreva("Digite a categoria de acesso (P - Professor, A - Aluno, F - Funcionário): ")
                leia(categoria)
                
                // Converte para maiúsculo para evitar problemas com letras minúsculas
                categoria = txt.caixa_alta(categoria) 

                se (categoria != "P" e categoria != "A" e categoria != "F")
                {
                    escreva("Categoria inválida! Tente novamente.\n")
                }
            } enquanto (categoria != "P" e categoria != "A" e categoria != "F")

            // O primeiro caractere da senha obrigatoriamente indica a categoria
            senha_gerada = categoria

            // Laço para gerar os outros 7 caracteres aleatórios (completando 8 no total)
            para (j = 1; j <= 7; j++)
            {
                // Sorteia um índice válido dentro da string de caracteres permitidos
                indice_aleatorio = u.sorteia(0, total_caracteres - 1)
                
                // Extrai o caractere sorteado e concatena na senha
                senha_gerada = senha_gerada + txt.extrair_subtexto(caracteres_permitidos, indice_aleatorio, indice_aleatorio + 1)
            }

            // Armazena a senha gerada no vetor
            senhas[i] = senha_gerada
            
            // Exibe a senha gerada no momento
            escreva("Senha gerada com sucesso: ", senha_gerada, "\n")
        }

        // --- Exibição do resultado final ---
        escreva("\n=========================================\n")
        escreva("      LISTA DAS 10 SENHAS GERADAS       \n")
        escreva("=========================================\n")
        
        para (i = 0; i < 10; i++)
        {
            escreva("Posição [", i + 1, "]: ", senhas[i], "\n")
        }
    }
}
